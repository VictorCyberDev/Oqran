generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // Prisma 7 no longer reads the connection URL from the schema: the CLI
  // (migrate/db push) gets it from prisma7.config.ts, and the runtime
  // client gets it via a driver adapter (see src/lib/db.ts).
  // TiDB Cloud Starter is MySQL wire-compatible but Prisma-enforced relations
  // avoid edge cases with FK constraint behavior on the serverless tier.
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  CITIZEN
  BUSINESS
  BANK
  GOVERNMENT
  DEVELOPER
  ADMIN
  /// The platform operator's own role. Never grantable through signup,
  /// invite, or admin approval — set only via the seed script or a direct
  /// database update against a specific, known account.
  PLATFORM_OWNER
}

enum AuthMethod {
  SMS
  EMAIL
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

model User {
  id                String     @id @default(cuid())
  role              Role
  phone             String?    @unique
  email             String?    @unique
  authMethod        AuthMethod @default(SMS)
  nin               String?    @unique
  status            UserStatus @default(ACTIVE)
  displayName       String?
  /// Demo-only account: OTP issuance skips real delivery and accepts a
  /// single fixed code instead. Never settable through any public signup
  /// or API path — only ever set directly by the seed script.
  isDemo            Boolean    @default(false)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  /// Standing within organizationId — irrelevant for users with none. A
  /// LEAD can invite/remove staff in their own org (see /api/org/staff/*);
  /// promotion to LEAD happens only via org-verify's isLeadRequest (on
  /// admin approval) or by being the one who created the organization.
  orgRole           OrgMemberRole @default(MEMBER)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  otpCodes           OtpCode[]
  trustedDevices     TrustedDevice[]
  verifiedAddresses  Address[]        @relation("VerifiedAddresses")
  reportedIncidents  Incident[]       @relation("ReportedIncidents")
  activityLogs       ActivityLog[]
  apiClients         ApiClient[]
  pendingApproval    PendingApproval?
  flaggedSignals     FraudSignal[]    @relation("FlaggedBy")
  resolvedSignals    FraudSignal[]    @relation("ResolvedBy")
  reviewedApprovals  PendingApproval[] @relation("ReviewedBy")
  zones              Zone[]
  raisedCases        Case[]           @relation("RaisedCases")
  caseNotes          CaseNote[]       @relation("CaseNoteAuthor")
  savedPlaces        SavedPlace[]     @relation("SavedPlaces")

  @@index([organizationId])
  @@map("users")
}

enum OrganizationType {
  BANK
  GOVERNMENT
  BUSINESS
}

enum OrgMemberRole {
  MEMBER
  LEAD
}

enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  type               OrganizationType
  inviteCode         String   @unique
  verificationStatus OrganizationVerificationStatus @default(PENDING)
  registrationRef    String?  // BVN (bank) or NIN/service ID (government officer)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users            User[]
  pendingApprovals PendingApproval[]
  subscription     Subscription?

  @@map("organizations")
}

enum PlanTier {
  FREE
  STANDARD
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Structured placeholder — no payment provider is wired yet. Amounts are
/// in Naira. Ready to be driven by a real billing integration later; for
/// now this is manually entered/seeded so the owner dashboard has
/// something real to show instead of a blank section.
model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id])
  planTier       PlanTier           @default(FREE)
  status         SubscriptionStatus @default(TRIAL)
  amount         Float              @default(0)
  billingCycle   BillingCycle       @default(MONTHLY)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("subscriptions")
}

enum OtpPurpose {
  SIGN_IN
  CREATE_ACCOUNT
  ORG_VERIFY
}

model OtpCode {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  /// Always an email address — the only verification channel.
  target       String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(5)
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([target, purpose])
  @@index([userId])
  @@map("otp_codes")
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  deviceTokenHash String    @unique
  pinHash         String
  label           String
  userAgent       String?
  approxLocation  String?
  lastUsedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([userId])
  @@map("trusted_devices")
}

// ---------------------------------------------------------------------------
// Spatial risk data
// ---------------------------------------------------------------------------

enum AddressConfidenceTier {
  NIMC_CERTIFIED
  STATE_GIS
  CROWD_REPORTED
}

enum RiskSeverity {
  LOW
  GUARDED
  ELEVATED
  CRITICAL
}

model Address {
  id             String                 @id @default(cuid())
  label          String
  latitude       Float
  longitude      Float
  confidenceTier AddressConfidenceTier
  source         String
  postcode       String?
  zoneType       String?
  severity       RiskSeverity           @default(LOW)
  verifiedById   String?
  verifiedBy     User?                  @relation("VerifiedAddresses", fields: [verifiedById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  incidents    Incident[]
  fraudSignals FraudSignal[]
  cases        Case[]
  savedPlaces  SavedPlace[]

  @@index([latitude, longitude])
  @@index([verifiedById])
  @@map("addresses")
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Incident {
  id            String         @id @default(cuid())
  type          String
  severity      RiskSeverity
  description   String?
  addressId     String?
  address       Address?       @relation(fields: [addressId], references: [id])
  latitude      Float?
  longitude     Float?
  reporterId    String?
  reporter      User?          @relation("ReportedIncidents", fields: [reporterId], references: [id])
  status        IncidentStatus @default(SUBMITTED)
  referenceCode String         @unique
  /// Client-generated id for a write that may have been queued offline and
  /// replayed. Nullable so existing rows are untouched — MySQL/TiDB allow
  /// many NULLs in a unique index — and unique so a replay can't duplicate.
  clientRequestId String?      @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cases Case[]

  @@index([addressId])
  @@index([reporterId])
  @@map("incidents")
}

/// SHA-256 hash-chain audit trail. Rows are append-only; integrity is
/// verified by recomputing hash(payload + prevHash) per row (see
/// src/lib/ledger.ts) rather than enforced by the database.
model RiskLedgerEntry {
  id          String   @id @default(cuid())
  sequence    Int      @unique @default(autoincrement())
  payload     Json
  prevHash    String
  currentHash String   @unique
  createdAt   DateTime @default(now())

  @@map("risk_ledger")
}

enum FraudSignalSource {
  INTERNAL_REPORT
  PUBLIC_WATCHLIST
}

model FraudSignal {
  id           String            @id @default(cuid())
  addressId    String?
  address      Address?          @relation(fields: [addressId], references: [id])
  entityLabel  String
  signalType   String
  severity     RiskSeverity
  source       FraudSignalSource
  watchlistRef String?
  flaggedById  String?
  flaggedBy    User?             @relation("FlaggedBy", fields: [flaggedById], references: [id])
  flaggedAt    DateTime          @default(now())
  slaDeadline  DateTime
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?             @relation("ResolvedBy", fields: [resolvedById], references: [id])

  cases Case[]

  @@index([addressId])
  @@index([slaDeadline])
  @@index([flaggedById])
  @@index([resolvedById])
  @@map("fraud_signals")
}

// ---------------------------------------------------------------------------
// Activity, developer platform & governance
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  description String?
  device      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_log")
}

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

model ApiClient {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  name         String
  apiKeyHash   String          @unique
  apiKeyPrefix String
  scopes       String
  status       ApiClientStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  usage ApiUsage[]

  @@index([userId])
  @@map("api_clients")
}

model ApiUsage {
  id            String    @id @default(cuid())
  apiClientId   String
  apiClient     ApiClient @relation(fields: [apiClientId], references: [id])
  endpoint      String
  statusCode    Int
  billableUnits Int       @default(1)
  requestedAt   DateTime  @default(now())

  @@index([apiClientId, requestedAt])
  @@map("api_usage")
}

/// A business-watched area (delivery zone, logistics corridor, industrial
/// district). Not in the original screen set — added because the "My
/// Zones" list has nothing to list without it.
model Zone {
  id         String   @id @default(cuid())
  businessId String
  business   User     @relation(fields: [businessId], references: [id])
  name       String
  type       String
  latitude   Float
  longitude  Float
  radiusKm   Float    @default(2)
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@map("zones")
}

/// Fixed-window counter backing server-side rate limiting (OTP issuance,
/// incident submission, and every auth-adjacent route). Not user data.
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Cross-institution case management
// ---------------------------------------------------------------------------

/// Which institution a case originated from. The whole point of a case is
/// that a Government investigator can see work raised by parties who
/// otherwise have no view of each other, so the origin is first-class
/// rather than inferred from whatever record it happens to link to.
enum CaseSource {
  CITIZEN_REPORT
  BANK_ESCALATION
  INVESTIGATOR_FLAG
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
}

model Case {
  id            String       @id @default(cuid())
  referenceCode String       @unique
  title         String
  source        CaseSource
  status        CaseStatus   @default(OPEN)
  severity      RiskSeverity
  /// Context captured at creation — e.g. the escalating bank officer's
  /// note. Anything added later goes in CaseNote so the trail is ordered.
  summary       String?      @db.Text
  /// Originating institution's display name, denormalised so a case still
  /// reads correctly if that organization is renamed or its user removed.
  originLabel   String?
  addressId     String?
  address       Address?     @relation(fields: [addressId], references: [id])
  incidentId    String?
  incident      Incident?    @relation(fields: [incidentId], references: [id])
  fraudSignalId String?
  fraudSignal   FraudSignal? @relation(fields: [fraudSignalId], references: [id])
  raisedById    String?
  raisedBy      User?        @relation("RaisedCases", fields: [raisedById], references: [id])
  /// See Incident.clientRequestId — dedupes a replayed offline escalation.
  clientRequestId String?    @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notes CaseNote[]

  @@index([status, createdAt])
  @@index([addressId])
  @@index([incidentId])
  @@index([fraudSignalId])
  @@index([raisedById])
  @@map("cases")
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  authorId  String?
  author    User?    @relation("CaseNoteAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  /// See Incident.clientRequestId — dedupes a replayed offline note.
  clientRequestId String? @unique
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([authorId])
  @@map("case_notes")
}

/// A citizen's pinned address (home, work, a relative's place). Stores the
/// severity as of the last dashboard view so the next one can say "risk
/// increased near Home" rather than only ever showing a current value.
model SavedPlace {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation("SavedPlaces", fields: [userId], references: [id])
  addressId        String
  address          Address      @relation(fields: [addressId], references: [id])
  label            String
  lastSeenSeverity RiskSeverity
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, addressId])
  @@index([userId])
  @@map("saved_places")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingApproval {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  requestedRole  Role
  /// Applicant indicated they're the primary contact for the organization
  /// at org-verify signup. On admin approval, promotes the user to LEAD
  /// instead of adding a separate signup screen for it.
  isLeadRequest  Boolean        @default(false)
  referenceCode  String         @unique
  status         ApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote     String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?

  @@index([organizationId])
  @@index([reviewedById])
  @@index([status])
  @@map("pending_approvals")
}
