# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# TiDB Cloud Starter connection string (MySQL wire-protocol compatible).
# TiDB Cloud serves publicly-trusted TLS certs, so ssl=true is sufficient.
DATABASE_URL="mysql://<user>:<password>@<host>:4000/<database>?ssl=true"

# Per-process connection pool size (see src/lib/db.ts). Each serverless
# instance holds its own pool, so this is divided across however many run
# concurrently, not a single shared budget — keep it low. Default: 3.
DATABASE_CONNECTION_LIMIT="3"

# JWT session signing key (jose). Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=""

# bcrypt cost factor for hashing OTP codes and device-trust tokens.
AUTH_BCRYPT_ROUNDS="12"

# REQUIRED in production — every non-demo sign-in/create-account attempt
# sends a real OTP email via Resend (https://resend.com). Without both of
# these set, OTP issuance throws in production by design (it never
# silently drops a code instead of sending it) rather than falling back to
# the dev console-log path. EMAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="OQRAN <noreply@yourdomain.com>"

# Public base URL of the deployed app. Currently unused by any code path
# (OTP emails are plain-text with no links; /api/v1/** CORS is a hardcoded
# wildcard, not driven by this) — reserved for when either needs it. Safe
# to leave as-is.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Overrides the default OSM raster basemap on the Government
# Spatial Grid map (src/components/gov/SpatialMap.tsx) with a MapLibre
# style URL from a tile provider (Mapbox/MapTiler/Stadia) — needed before
# relying on this for production tile-usage volume. Leave unset to use the
# built-in OSM style.
NEXT_PUBLIC_MAP_STYLE_URL=""

# The single platform-owner account. Seeded with role=PLATFORM_OWNER — never
# grantable through signup, invite, or admin approval.
PLATFORM_OWNER_EMAIL="owner@oqran.ng"
